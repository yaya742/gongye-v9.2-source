# 共页 v10 生产反向代理（仅示例，未在用户服务器运行 nginx -t）。
# PUBLIC_ORIGIN=https://gongye.example.com，Node仅监听127.0.0.1:8787。
# 所有URL由Node公开白名单和鉴权服务处理，绝不root整个工程。
# 替换域名与证书后，在服务器用 nginx -t 检验再启用。

server {
    listen 80;
    listen [::]:80;
    server_name gongye.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name gongye.example.com;

    # certbot --nginx -d gongye.example.com 会自动生成这两行
    ssl_certificate     /etc/letsencrypt/live/gongye.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gongye.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    charset utf-8;
    client_max_body_size 20m;
    client_body_timeout 35s;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'" always;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css text/javascript application/javascript application/json image/svg+xml;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        # 原始Origin、Cookie、X-Requested-With须原样转发，不可伪造为同源。
        proxy_connect_timeout 5s;
        proxy_read_timeout 100s;
        proxy_send_timeout 40s;
        proxy_cache off;
    }
    # 可按实际容量增加受信代理层限流；不能关闭Node的同源与活跃账号校验。
}
